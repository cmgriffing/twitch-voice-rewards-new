# Environment schema for @repo/openrouter-video-cli.
#
# Committed source of truth for the variables this CLI reads. It contains no
# secret values: the real OPENROUTER_API_KEY belongs in the gitignored .env
# file beside this schema, and varlock validates it before a wrapped command
# starts. Agents can read this file for full context without seeing secrets.
#
# @defaultRequired=infer @defaultSensitive=false
# ---

# OpenRouter API key used for STT and video generation requests. Required for
# every wrapped invocation; stored locally in .env, never committed.
# @required @sensitive @type=string(startsWith=sk-or-)
# @docs(https://openrouter.ai/docs/api-reference/authentication)
OPENROUTER_API_KEY=

# ---
# Optional tool overrides. Leave unset to resolve ffmpeg/ffprobe from PATH.

# Path to the ffmpeg binary used to probe and assemble media.
# @optional @type=string
FFMPEG_PATH=

# Path to the ffprobe binary used to inspect media metadata.
# @optional @type=string
FFPROBE_PATH=
